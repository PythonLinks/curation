<style>  .navbar {background-color:#00b563;}<!--WARNING--><!-- MISTAKES HERE CAN CRASH THE SITE--><!--USER FORMS REQUIRE IT--></style><!--BACK UP YOUR DataBase First--><!--WARNING--><nav class="navbar navbar-expand-md navbar-dark default-color" tal:define="contextPath view.contextPath(); isAuthenticated view.isAuthenticated();"><button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarsExample04" aria-controls="navbarsExample04" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"> </span></button>  <div class="collapse navbar-collapse" id="navbarsExample04">    <li class="nav-item" tal:condition="True"><a class="nav-link" href="${view.contextPath()}">View </a></li>    <ul class="navbar-nav mr-auto"><!-- ADD CONTENT--><li class="nav-item dropdown" tal:condition="view.treeSecurity()" tal:define="baseURL '/'+ context.__name__"><a class="nav-link dropdown-toggle" id="dropdown05" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Node</a>  <div class="dropdown-menu" aria-labelledby="dropdown05"><span><a class="dropdown-item" tal:condition="view.implements('dolmen.container.IBTreeContainer')" href="/${context.__name__}/manage" target="_self">Manage</a><a class="dropdown-item" href="${view.contextURL('edit')}" target="_self" tal:condition="view.implements('zopache.ttw.interfaces.ICkHTML')">Edit</a><a class="dropdown-item" tal:condition="view.implements('zopache.ttw.interfaces.ISource')" href="${view.contextURL('history')}" target="_self">History</a><a class="dropdown-item" tal:condition="not view.implements('zopache.pages.interfaces.IRootPage')" href="${view.contextURL('delete')}" target="_self">Delete </a><a class="dropdown-item" tal:condition="hasattr(context,'webApproved')" href="${context.__name__}/approve" target="_self">Approve</a></span></div></li>      <!-- ADD CONTENT--><li class="nav-item dropdown" tal:condition="view.treeSecurity()" tal:define="baseURL '/'+ context.__name__"><a class="nav-link dropdown-toggle" id="dropdown05" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">+Content</a>  <div class="dropdown-menu" aria-labelledby="dropdown05"><span tal:condition="view.isAuthenticated()"><a class="dropdown-item" href="${baseURL}/addJSONMarkdown" target="_self">Wiki Page</a>      <!--a.dropdown-item( href="${baseURL}/addMultilingual" ) Multi-Lingual--><a class="dropdown-item" href="${baseURL}/addVideo" target="_self">YouTube Video</a><a class="dropdown-item" href="${baseURL}/addLogo">Logo</a><a class="dropdown-item" href="${baseURL}/addBanner" target="_self">Banner</a><a class="dropdown-item" target="_self" href="${baseURL}/addSocialMediaImage">Social Media Image</a><a class="dropdown-item" href="${baseURL}/addFile" target="_self">File</a></span></div></li>      <!-- ADD CONTENT--><li class="nav-item dropdown" tal:condition="view.treeSecurity()" tal:define="baseURL '/'+ context.__name__"><a class="nav-link dropdown-toggle" id="dropdown05" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Tree</a>  <div class="dropdown-menu" aria-labelledby="dropdown05"><span tal:condition="view.isManager() and hasattr(context,'webClass')" tal:omit-tag=""><a class="dropdown-item" href="Products/${context.webClass}/manage" target="_blank">Web Class</a></span><a class="dropdown-item" href="/Products/Layouts/manage" target="_blank">Layouts</a><a class="dropdown-item" href="/Products/Templates/manage" target="_blank">Templates</a><a class="dropdown-item" href="/person/manage" target="_blank">People</a><a class="dropdown-item" href="/undo" target="_blank">Transactions </a></div></li>      <!-- ADD CONTENT--><li class="nav-item dropdown" tal:condition="view.treeSecurity()" tal:define="baseURL '/'+ context.__name__"><a class="nav-link dropdown-toggle" id="dropdown05" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Commands</a>  <div class="dropdown-menu" aria-labelledby="dropdown05"><span><a class="dropdown-item" href="${context.__name__}/editors">Editors</a><a class="dropdown-item" href="/pack" target="_blank">Pack</a><a class="dropdown-item" href="./newest-items">Most Recent</a><a class="dropdown-item" href="/reIndex" target="_blank">ReIndex</a><a class="dropdown-item" tal:condition=" view.implements('dolmen.container.IBTreeContainer')" href="${view.contextURL('restore')}">Restore </a><a class="dropdown-item" href="${view.contextURL('forest-wiki-backup')}">Download Backup</a></span></div></li>      <li class="nav-item dropdown ml-auto" tal:condition="not view.isAuthenticated() and view.getSiteRoot().mastodonLogin"><a class="nav-link dropdown-toggle" id="dropdown05" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Login</a>  <div class="dropdown-menu" aria-labelledby="dropdown05"><span><a class="dropdown-item" href="/how-to-register">Register </a><a class="dropdown-item" href="/oauth/${view.getDomain()}/climatejustice.social/moauth">ClimateJustice.Social </a><a class="dropdown-item" href="/oauth/${view.getDomain()}/union.place/moauth">Union.Place</a><a class="dropdown-item" href="/oauth/${view.getDomain()}/mstdn.social/moauth">Mstdn.Social</a><a class="dropdown-item" href="/oauth/${view.getDomain()}/mastodon.social/moauth">Mastodon.Social</a><a class="dropdown-item" href="/other-servers">Other OAuth Servers </a></span></div></li></ul>    <ul class="navbar-nav mr-auto">      <li class="nav-item"> <a class="nav-link" href="/contact">Contact</a></li>      <li class="nav-item" tal:condition="not isAuthenticated and view.getSiteRoot().localLogin">        <form class="form-inline" action="/${context.__name__}/login"><button class="btn btn-primary my-2 my-sm-0" type="submit">Log In</button></form>      </li>      <li class="nav-item" tal:condition="not isAuthenticated and view.getSiteRoot().googleClientId">        <form class="form-inline" action="/${context.__name__}/login"><button class="btn btn-primary my-2 my-sm-0" type="submit">G. Log In</button></form>      </li>      <li class="nav-item ml-auto mr-2" tal:condition="isAuthenticated">        <form class="form-inline" action="/${context.__name__}/logout"><button class="btn btn-secondary my-2 my-sm-0" type="submit">Log Out</button></form>      </li>    </ul>  </div></nav>