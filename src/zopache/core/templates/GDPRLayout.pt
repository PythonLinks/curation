<!DOCTYPE html>
<html lang="en">
  <head>
    <base href="${view.getSiteRoot().basePath}">
    ${structure: view.headerScripts()}
    <meta content="IE=edge" http-equiv="X-UA-Compatible">
    <meta charset="utf-8" />
    <title>${view.title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="" />
  </head>
  <body class="bg-light">
    ${structure: view.layoutAcquire("navbar.py")(view)}
    <div style = "padding-left: 20px;">
      ${structure: view.layoutAcquire('breadcrumbs')(view=view)}
      <div>
	<img src = "/images/gdpr.png"
	style = "margin:auto; display:block; max-height:40vh ">
      </div>
      <div class="container">
      <center>
      <h1>${view.acquireTitle()}</h1>
      <h2>${view.subTitle}</h2>
      </center>
    </div>    
     
    <a name="content"></a>
     <a name="manage"></a>
    <div id="wrapper">
      <div class="container" id="page-content-wrapper">
	<div id="main">
	  <div id="content">
            <center>
              <span style = "color:red">
		${structure: view.submissionError}
	      </span>
            </center>
	    <div tal:condition="hasattr(view,'error')"
		 style="color:red;">${view.error} </div>
	  <div tal:replace="structure content" />
	  </div>
	</div>
      </div>
      
      <div id="footer">
	${structure: view.footerScripts()}
      </div>
    </div>
    </div>
  </body>
</html>
    
