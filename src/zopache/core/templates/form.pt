<form tal:attributes="action view.action_url;
                                 id view.htmlId();
                                 method view.formMethod;
                                 enctype view.enctype">

  <h1 tal:condition="view.label"
      tal:content="view.label">Label</h1>
  
  <p class="form-status" 
     tal:condition="view.status">
     ${structure: view.status}</p>

  <div class="text-danger"
       tal:condition="view.errors" style = "color:red">
       ${structure: view.submissionError}
    <ul tal:condition="view.formErrors"
        tal:repeat="error view.formErrors">
      <li> <span tal:replace="error.title" /> </li>
    </ul>
  </div>
  <div class="text-danger" style="color:red">
    <ul tal:condition="view.submissionErrors"
        tal:repeat="error view.submissionErrors">
      <li> <span tal:replace="error" /> </li>
    </ul>
  </div>

  <p tal:condition="view.description"
     tal:content="structure: view.description">Description</p>
  

  <span style= "max-width:40em" tal:condition="hasattr(view,'preamble')">
  <p>${structure: view.preamble}</p><br></span>  

  <tal:fields condition="view.fieldWidgets">
    <div tal:attributes="class widget.required and 'form-group required' or 'form-group'"
	 tal:repeat="widget view.bootstrap_widgets()">
      <span tal:content="structure view.before(widget)"></span>
      
      <tal:widget  tal:condition= "view.isBool(widget)"  tal:content="structure widget.render()" />&nbsp;<label for="#"
             tal:attributes="for widget.htmlId()"
             tal:content="widget.title"
             tal:condition="widget.visible" />
      <p tal:condition="widget.description and widget.visible"
	 tal:content="widget.description"
	 class="field-description" />
      <p class="text-danger"
	 tal:define="error widget.error"
	 tal:condition="error"
	 tal:content="error.title" />

      <tal:widget  tal:condition= " not view.isBool(widget)"  tal:content="structure widget.render()" />
    </div>
  </tal:fields>
  <div>
  <tal:actions tal:condition="view.actionWidgets">
    <tal:widget tal:content="structure widget.render()"
		tal:repeat="widget view.bootstrapActionWidgets()" />
  </tal:actions>
  </div>
</form>

 <div tal:condition="not view.allowAnonymous and not view.treeSecurity()">
  <p> Since you do not have permission to edit this page, the buttons
  below will not do anything.  
  </p>
    <input type="submit" id="form-action-save--and-view" name="form.action.save--and-view" value="Save -&gt; View" class="action btn" accesskey="#" />
<input type="submit" id="form-action-save" name="form.action.save" value="Save" class="action btn" accesskey="#" />
<input type="submit" id="form-action-save--and-aceedit" name="form.action.save--and-aceedit" value="Save -&gt; AceEdit" class="action btn" accesskey="#" />
<input type="submit" id="form-action-save--and-test" name="form.action.save--and-test" value="Save -&gt; Test" class="action btn" accesskey="#" />
<input type="submit" id="form-action-cancel" name="form.action.cancel" value="Cancel" class="action btn" accesskey="#" />

  
  </div>
<br>
  <p style= "max-width:40em" tal:condition="hasattr(view,'postamble')">
  ${view.postamble}</p>
      <script>
        //NO COMMENT
	document.getElementById('form-action-Cancel').addEventListener("click",
	function(){
	window.location.href = '..';
	        });
      </script>