<style>
btn-primary{
     margin:20px;
          }

.table-condensed>thead>tr>th,
.table-condensed>tbody>tr>th,
.table-condensed>tfoot>tr>th,
.table-condensed>thead>tr>td,
.table-condensed>tbody>tr>td,
.table-condensed>tfoot>tr>td{
    padding-top: 2px;
        padding-bottom: 2px;
	    }
</style>
<span tal:condition ="view.context.values()">
Number of Children  = ${len(list(view.context.values()))}
</span>

<form method="post" action="${view.action_url}">

<table id="sortable" class="table  table-striped table-responsive 
table-hover table-condensed" summary="Content listing"
             i18n:attributes="summary"
             tal:define = "ordered view.isOrderedContainer()">


   <thead  class="thead-inverse">
     <tr>
      <th><a onClick="checkAll()">Check<br>All</a></th>
      <th>Icon</th>
      <th> Name->Manage </th>
      <th> Title->Edit </th>
      <th> Class->View </th>
      <th> Size </th>
      <th> Age </th>
     </tr>
    </thead>

    <tbody> 
      <metal:block tal:repeat="item view.contents()">
      <tr tal:define="oddrow repeat.item.odd; url item.url;">
        <td>
	     <a tal:condition = "ordered" href = "${view.absoluteURL(item.context)}/moveUp">&#8593; </a>
	     <a tal:condition = "ordered" href = "${view.absoluteURL(item.context)}/moveDown">&#8595;</a>
	     <input   id = "${repeat.item.number}-checkBox"
	      type="checkbox"
	      name="ids_list"
              onclick = "clickBox('${item.id()}')"
              tal:attributes="value item.id()">

        </td>
																		                      <td>
           ${structure: view.iconHTML(item.context)}
        </td>
	
	<td>
	<textarea  style = "display: none;"
	id = "${repeat.item.number}-editName"
        name= "newNameValue_list"
        tal:content="item.id()">
        </textarea>

         <span tal:switch="item.isBTreeContainer()"
	 id = "${repeat.item.number}-showName">
	 <span tal:case = "True">
	 <a href = " ${view.url(item.context)}/manage">
	   ${item.context.__name__}</a>
	 </span>
	 <span tal:case= "False">
	 ${item.context.__name__}
	 </span>
	 </span>


	 <td>
	 
	 <textarea  style = "display: none;"
	 id = "${repeat.item.number}-editTitle"
	 rows ="${3 if item.context.__class__.__name__=='ConferenceVideo' else '1'}"
	 name= "newTitleValue_list"
	 tal:content="item.title() ">
	 </textarea>
        <a id = "${repeat.item.number}-showTitle"
         href = "${view.getLongURL(item.context) + item.editTag()}"
	>${item.title() or '---' }</a>
	  </td>
	  
	  <td>
	 <a href = " ${view.url(item.context)}">
	   ${item.contextClassName()}</a>
	 </td>

            <td><span tal:content="item.size()">
	                          &nbsp;</span></td>
				              <td><span tal:content="item.modified()">&nbsp;</span></td>
					                </tr>
							        </metal:block>

        </tbody>
	      </table>
<?python
cutItems = []
showCuts = False
if view.isAuthenticated():
   cutItems  = list(view.request.principal['cutFolder'].values())
   showCuts = True
?>
  <div   tal:condition = "showCuts">
   Pastable Items:
     <span  tal:repeat="item cutItems" style = "color:red">
        ${item.name}
    </span>
  </div>


<span>
  <tal:actions tal:condition="view.actionWidgets">
      <tal:widget tal:content="structure widget.render()"   tal:repeat="widget view.bootstrapActionWidgets()" />
        </tal:actions>
	  </span>

 <span tal:condition="not view.treeSecurity()">
    <p>The ReName, and ReTitle Buttons act on the display, but you do not have permission to make changes on the server.</p>
     <input type="button" id="form-action-ReName" name="form.action.ReName" value="ReName" class="action btn" accesskey="#">
     <input type="button" id="form-action-ReTitle" name="form.action.ReTitle" value="ReTitle" class="action btn" accesskey="#">
     <input type="button" id="form-action-Cut" name="form.action.Cut" value="Cut" class="action btn" accesskey="#">
     <input type="button" id="form-action-Copy" name="form.action.Copy" value="Copy" class="action btn" accesskey="#">
     <input type="button" id="form-action-Paste" name="form.action.Paste" value="Paste" class="action btn" accesskey="#">
     <input type="button" id="form-action-Delete" name="form.action.Delete" value="Delete" class="action btn" accesskey="#">
      </span>
      </form>
      
<script src="/Products/Templates/Manage.js"></script>

