@form_component
#@name (u'aceedit')
@context(IInternalPrincipal)
@implementer(ITreeSecurity)
class AceEditPrincipal(AceEdit):
    title = 'Ace Edit Your Profile'
    interface = IEdit
    @property
    def fields(self):
        return  Fields(self.interface)
    
@form_component
