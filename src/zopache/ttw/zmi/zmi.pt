<button class="btn btn-primary" onClick ="showNames()"
               tal:condition="view.supportsName"
               >Edit Names</button>  

<button class="btn btn-primary"  onClick ="showTitles()"
               tal:condition="view.supportsRetitle"
               >Edit Tiitle </button>  
