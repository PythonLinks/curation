<style>
td,th {padding-left: 20px; padding-right:20 px;}
</style>

<table>
<tr>
  <th></th>
  <th>Restore</th>
  <th>Titile</th>
  <th>Age</th>
</tr>
<tr  tal:repeat="result view.results()" >
    <td tal:content=" repeat.result.index">0, 1, 2 </td>
    <td> ${structure: view.reverseURL(result['id'])}</td>
    <td> ${structure: result['description']}</td>    
    <td>${structure: view.humanizeTime(result['time'])}</td>
     </tr>
     
   </table>
