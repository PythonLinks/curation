<form action="." tal:attributes="action view.action_url;
                                 id view.htmlId();
                                 method view.formMethod;
                                 enctype view.enctype">

  <h1 tal:condition="view.label"
      tal:content="view.label">Label</h1>
  
  <p tal:condition="view.description"
     tal:content="view.description">Description</p>
  
  <p class="form-status"
     tal:condition="view.status"
     tal:content="view.status">Status</p>
  
  <div class="form-error"
       tal:condition="view.errors">
    <ul tal:condition="view.formErrors"
        tal:repeat="error view.formErrors">
      <li> <span tal:replace="error.title" /> </li>
    </ul>
  </div>

  <div class="form-error"
       tal:condition="view.errors">
    <ul tal:condition="view.submissionError"
        tal:repeat="error view.submissionError">
      <li> <span tal:replace="error.title" /> </li>
    </ul>
  </div>

    <input id="form-field-chatPermission-present" name="form.field.chatPermission.present" class="field form-control form-control "  checked="checked" value="True" type="hidden" required="required" />

    <input id="form-field-votePermission-present" name="form.field.votePermission.present" class="field form-control"  checked="checked" value="True" type="hidden" required="required" />



<tal:fields condition="view.fieldWidgets">
    <div tal:attributes="class widget.required and 'form-group required' or 'form-group'"
	 tal:repeat="widget view.bootstrap_widgets()">
	    <span 
             tal:condition="widget.visible" >

      ${structure: widget.render() if (widget.__class__.__name__=='CheckBoxWidget') else ""}
	     ${widget.title}
</span>

<div tal:condition="widget.__class__.__name__!='CheckBoxWidget'">
      <tal:widget tal:content="structure widget.render()" />
	    </div>

    <small id="handleHelp" class="form-text text-muted"
         tal:condition="widget.description"
	 tal:content="widget.description"
	 />
      <p class="field-error"
	 tal:define="error widget.error"
	 tal:condition="error"
	 tal:content="error.title" />

    </div>
  </tal:fields>



<tal:actions tal:condition="view.actionWidgets">
    <tal:widget tal:content="structure widget.render()"
		tal:repeat="widget view.actionWidgets" />
  </tal:actions>
</form>
