  <p class="form-status"
     tal:condition="view.status"
     tal:content="view.status">Status</p>
  
  <div class="form-error"
       tal:condition="view.errors">
    <ul tal:condition="view.formErrors"
        tal:repeat="error view.formErrors">
      <li> <span tal:replace="error.title" /> </li>
    </ul>

<form action="." tal:attributes="action view.action_url;
                                 id view.htmlId();
                                 method view.formMethod;
                                 enctype view.enctype"
	  tal:define="widgets view.widgetDictionary()"
	  >
	 

<div class="form-group required "
    tal:define="widget widgets['form-field-handle']">
     <label for="form-field-handle" class = "required">Handle</label>
${structure: widget.render()}

    <small id="handleHelp" class="form-text text-muted">Your Publically Visible Name.</small>
    <div tal:condition="view.fieldWidgets"      >

<p class="field-error"
	 tal:define="error view.fieldWidgets['form.field.handle'].error"
	 tal:condition="error"
	 tal:content="error.title" />
	 </div>
    </div>

<div class="form-group required"
     tal:define="widget widgets['form-field-email']">
<label for="form-field-email">Your Email Address</label>


${structure: widget.render()}
    <small id="emailHelp" class="form-text text-muted">We'll never share your email with anyone else.</small>
    <div tal:condition=view.fieldWidgets">
       <p class="field-error"
	 tal:define="error view.fieldWidgets['form.field.email'].error"
	 tal:condition="error"
	 tal:content="error.title" />
	 </div>

    </div>

    <div class="form-group required"
        tal:define="widget widgets['form-field-password']">
<label for="form-field-password">Password</label>
${structure: widget.render()}
        <small id="passwordHelp" class="form-text text-muted">
Be strong!
	</small>
<div tal:condition=view.fieldWidgets">
       <p class="field-error"
	 tal:define="error view.fieldWidgets['form.field.password'].error"
	 tal:condition="error"
	 tal:content="error.title" />
	 </div>
</div>



    <input id="form-field-chatPermission-present"
    name="form.field.chatPermission.present"
    class="field form-control form-control form-control form-control form-control form-control form-control form-control"  checked="checked" value="True" type="hidden" required="required" />

    <p> I give permission to process my professional information for the following purposes:</p>
    
<div class="form-check required"
   tal:define="widget widgets['form-field-chatPermission']">



<input type="checkbox" class="form-check-input required"
id="form-field-chatPermission" name="form.field.chatPermission"
value="${widget.value['form.field.chatPermission']}"  required="required" />

<label class="form-check-label required" for="exampleCheck1">
To manage the servers.</label>
<div tal:condition="view.fieldWidgets"  >
       <p class="field-error"
	 tal:define="error view.fieldWidgets['form.field.chatPermission'].error"
	 tal:condition="error"
	 tal:content="error.title" />
	 </div>
</div>


<button type="submit" class="btn btn-primary"
    id="form-action-add" name="form.action.add" value="Add"
    >Submit</button>
</form>
